{
  "general": {
    "css_selectors": {
      "a[href*=dataset]": "dataset",
      "a[href*=data]": "dataset",
      "a[href*=supplementary]": "supplementary",
      "a[href*=pdf]": "supplementary"
    },
    "xpaths": {
    },
    "bad_patterns": [
    ],
    "skip_llm_classification_patterns": {
            "scholar.google.com": "Related Works"
    },
    "pub_page_keywords": [
      "publication", "publications", "papers", "pubs", "articles", "journal", "preprint"
    ],
    "pub_id_patterns": [
      "\\b(PMC\\d{4,})\\b",
      "(?i)\\bPMID\\s*:?\\s*(\\d{7,8})\\b",
      "pubmed\\.ncbi\\.nlm\\.nih\\.gov/(\\d{7,8})",
      "(10\\.\\d{4,}/[^\\s<>\"']{4,})",
      "doi\\.org/(10\\.[^\\s<>\"']{4,})"
    ],
    "pubmed_search_patterns": [
      "pubmed\\.ncbi\\.nlm\\.nih\\.gov/\\?term=([^\\s<>\"']+)",
      "pubmed\\.ncbi\\.nlm\\.nih\\.gov/\\?term=([^\\s<>\"']+)&"
    ]
  },
  "nature": {
    "css_selectors": {
      ".additional-information a": "supplementary",
      "#data-availability-content a": "supplementary",
      "#additional-information-section a": "supplementary",
      "[data-title~=Supplementary] a": "supplementary",
      "[data-title~=Data] a": "dataset"
    },
    "xpaths": {
      "//h2[contains(text(), 'Source Data')]": "dataset"
    }
  },
  "sciencedirect": {
    "css_selectors": {
      ".Appendices a": "dataset",
      "#da0010 a": "dataset",
      "#da0010 a": "dataset"
    },
    "xpaths": {
      "//h2[contains(text(), 'Data and code availability')]": "dataset",
      "//h4[contains(text(), 'Data and code availability')]": "dataset"
    },
    "bad_patterns": [
      "/supporthub/"
    ]
  },
  "thelancet": {
    "css_selectors": {
      ".article__sections .section-paragraph a[href*='dataset']": "dataset",
      ".article__sections .refs .ref__title a[href*='dataset']": "dataset",
      ".supplemental-information__item a": "supplementary"
    }
  },
  "PMC": {
    "css_selectors": {
      "data_availability_sections": {
        "section.data-availability-statement": "dataset",
        "section.associated-data": "dataset",
        "h2.pmc_sec_title:-soup-contains('Data Availability')": "dataset",
        "h3.pmc_sec_title:-soup-contains('Data Availability')": "dataset"
      },
      "supplementary_data_sections": {
        "h2.pmc_sec_title:-soup-contains('Extended Data')": "dataset",
        "h3.pmc_sec_title:-soup-contains('Clinical Data')": "dataset",
        "h2.pmc_sec_title:-soup-contains('Associated Data')": "dataset",
        "h2.pmc_sec_title:-soup-contains('Footnotes')": "dataset"
      },
      "supplementary_material_sections": {
        "section.supplementary-material": "supplementary",
        "h2.pmc_sec_title:-soup-contains('Supplementary Material')": "supplementary"
      },
      "funding_sections": {
        "section.funding": "funding",
        "section.acknowledgments": "funding",
        "h2.pmc_sec_title:-soup-contains('Funding')": "funding",
        "h3.pmc_sec_title:-soup-contains('Funding')": "funding",
        "h2.pmc_sec_title:-soup-contains('Acknowledgments')": "funding",
        "h2.pmc_sec_title:-soup-contains('Acknowledgements')": "funding",
        "h2.pmc_sec_title:-soup-contains('Financial Disclosure')": "funding",
        "h2.pmc_sec_title:-soup-contains('Financial Support')": "funding",
        "h2.pmc_sec_title:-soup-contains('Grant Support')": "funding"
      },
      "code_availability_sections": {
        "section.code-availability-statement": "software",
        "h2.pmc_sec_title:-soup-contains('Code Availability', 'Code availability')": "software",
        "h3.pmc_sec_title:-soup-contains('Code Availability', 'Code availability')": "software",
        "h2.pmc_sec_title:-soup-contains('Software Availability', 'Software availability')": "software",
        "h2.pmc_sec_title:-soup-contains('Data and Code Availability', 'Data and code availability')": "software",
        "h2.pmc_sec_title:-soup-contains('Availability of Data and Materials', 'Availability of data and materials')": "software"
      }
    },
    "xpaths": {
      "data_availability_sections": [
        "//section[h2[contains(text(), 'Data Availability')]]",
        "//section[h3[contains(text(), 'Data Availability')]]",
        "following-sibling::p[1]",
        "//section[h2[contains(text(), 'Footnotes')]]",
        "//sec[title[contains(translate(text(), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'data availability')]]"
      ],
      "supplementary_data_sections": [
        "//section[h2[contains(text(), 'Supplementary Material')]]",
        "//section[h2[contains(text(), 'Extended Data')]]",
        "//section[h3[contains(text(), 'Clinical Data')]]",
        "//section[h3[contains(text(), 'Associated Data')]]",
        "//section[h2[contains(text(), 'Footnotes')]]"
      ],
      "funding_sections": [
        "//section[h2[contains(text(), 'Funding')]]",
        "//section[h3[contains(text(), 'Funding')]]",
        "//section[h2[contains(text(), 'Acknowledgments')]]",
        "//section[h2[contains(text(), 'Acknowledgements')]]",
        "//section[h2[contains(text(), 'Financial Disclosure')]]",
        "//section[h2[contains(text(), 'Financial Support')]]",
        "//section[h2[contains(text(), 'Grant Support')]]",
        "//sec[title[contains(translate(text(), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'funding')]]",
        "//sec[title[contains(translate(text(), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'acknowledg')]]",
        "//sec[title[contains(translate(text(), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'financial disclosure')]]",
        "//sec[title[contains(translate(text(), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'grant support')]]"
      ],
      "code_availability_sections": [
        "//section[h2[contains(text(), 'Code Availability')]]",
        "//section[h3[contains(text(), 'Code Availability')]]",
        "//section[h2[contains(text(), 'Software Availability')]]",
        "//sec[title[contains(translate(text(), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'code availability')]]",
        "//sec[title[contains(translate(text(), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'software availability')]]",
        "//sec[title[contains(translate(text(), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'availability of code')]]",
        "//sec[title[contains(translate(text(), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'data and code availability')]]",
        "//sec[title[contains(translate(text(), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'availability of data and materials')]]"
      ]
    },
    "xml_tags": {
      "data_availability_sections": [
        ".//sec[@sec-type='data-availability']",
        ".//notes[@notes-type='data-availability']",
        ".//notes[@notes-type='data-availability']"
      ],
      "supplementary_material_sections": [
        ".//supplementary-material"
      ],
      "supplementary_data_sections": [
        ".//sec[@sec-type='supplementary-material']",
        ".//supplementary-material",
        ".//sec[@sec-type='associated-data']",
        ".//sec[@sec-type='extended-data']",
        ".//sec[@sec-type='samples-and-clinical-data']",
        ".//sec[@sec-type='footnotes']"
      ],
      "key_resources_table": [
        "//sec[.//title[contains(text(), \"Key resources table\")]]//table-wrap"
      ],
      "methods_sections": [
        ".//sec[@sec-type='STAR★Methods']"
      ],
      "funding_sections": [
        ".//ack",
        ".//sec[@sec-type='funding']",
        ".//sec[@sec-type='acknowledgment']",
        ".//sec[@sec-type='acknowledgments']",
        ".//sec[@sec-type='financial-disclosure']",
        ".//sec[@sec-type='COI-statement']",
        ".//fn-group/fn[@fn-type='financial-disclosure']",
        ".//fn-group/fn[@fn-type='supported-by']",
        ".//notes[@notes-type='financial-disclosure']",
        ".//notes[@notes-type='COI-statement']"
      ],
      "funding_group_metadata": [
        ".//funding-group",
        ".//funding-group/funding-statement",
        ".//funding-group/award-group",
        ".//funding-group/award-group/funding-source",
        ".//funding-group/award-group/award-id",
        ".//funding-group/award-group/principal-award-recipient"
      ],
      "code_availability_sections": [
        ".//sec[contains(concat('|', translate(@sec-type, ' ', '|'), '|'), '|code-availability|')]"
      ]
    }
  }
}