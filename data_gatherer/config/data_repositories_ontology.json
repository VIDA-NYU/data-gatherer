{
  "meta": {
    "name": "Data Repositories Ontology",
    "version": "2.1",
    "namespace": "https://github.com/VIDA-NYU/data-gatherer/ontology/dro#",
    "description": "Controlled vocabulary to reconstruct dataset page URLs, match and filter sections that may contain dataset information, and clean dataset citations from literature Scoped to entities that are genuine dataset repositories; see biomedical_entity_id_patterns.json for ontology/annotation/identifier-scheme entities.",
    "sources": [
      "europepmc_whatizit-ana_accession_patterns_2018-12-10.mwt"
    ]
  },
  "repos": {
    "proteomexchange": {
      "type": "consortium",
      "name": "ProteomeXchange Consortium",
      "domains": [
        "proteomecentral.proteomexchange.org",
        "www.proteomexchange.org"
      ],
      "members": [
        "pride",
        "massive",
        "iprox",
        "jpost",
        "peptideatlas",
        "panoramapublic"
      ],
      "accessions": {
        "dataset": {
          "id_pattern": "\\bPXD\\d{5,10}",
          "level": "dataset",
          "scan_eligible": true,
          "url_template": "https://proteomecentral.proteomexchange.org/cgi/GetDataset?ID=__ID__"
        },
        "dataset_reanalysis": {
          "id_pattern": "RPXD\\d{6}",
          "level": "dataset",
          "scan_eligible": true
        }
      }
    },
    "pride": {
      "name": "PRIDE",
      "consortium": "proteomexchange",
      "domains": [
        "www.ebi.ac.uk"
      ],
      "retrieval": {
        "javascript_load_required": true,
        "access_mode": "Complex download",
        "download_root": "https://ftp.pride.ebi.ac.uk/pride/data/archive/__ID__/"
      }
    },
    "massive": {
      "name": "MassIVE",
      "consortium": "proteomexchange",
      "domains": [
        "massive.ucsd.edu"
      ],
      "retrieval": {
        "access_mode": "Complex download",
        "download_root": "ftp://massive.ucsd.edu/v06/__ID__/"
      },
      "accessions": {
        "dataset": {
          "id_pattern": "MSV\\d{9}",
          "level": "dataset",
          "scan_eligible": true,
          "url_template": "https://massive.ucsd.edu/ProteoSAFe/dataset.jsp?accession=__ID__"
        }
      }
    },
    "iprox": {
      "name": "iProX",
      "consortium": "proteomexchange",
      "domains": [
        "www.iprox.cn"
      ],
      "retrieval": {
        "access_mode": "Complex download"
      },
      "accessions": {
        "dataset": {
          "id_pattern": "IPX\\d{10}",
          "level": "dataset",
          "scan_eligible": false,
          "url_template": "https://www.iprox.cn/page/project.html?id=__ID__"
        }
      }
    },
    "jpost": {
      "name": "jPOST",
      "consortium": "proteomexchange",
      "domains": [
        "repository.jpostdb.org"
      ],
      "retrieval": {
        "access_mode": "Complex download"
      },
      "accessions": {
        "dataset": {
          "id_pattern": "JPST\\d{6,7}",
          "level": "dataset",
          "scan_eligible": true,
          "url_template": "https://repository.jpostdb.org/entry/__ID__"
        }
      }
    },
    "geo": {
      "name": "Gene Expression Omnibus",
      "domains": [
        "ncbi.nlm.nih.gov"
      ],
      "retrieval": {
        "access_mode": "Complex download"
      },
      "accessions": {
        "series": {
          "id_pattern": "GSE\\d+",
          "level": "dataset",
          "scan_eligible": true,
          "url_template": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=__ID__"
        },
        "sample": {
          "id_pattern": "GSM\\d+",
          "level": "record",
          "scan_eligible": true
        },
        "platform": {
          "id_pattern": "GPL\\d+",
          "level": "record",
          "scan_eligible": false
        },
        "dataset": {
          "id_pattern": "GDS\\d+",
          "level": "record",
          "scan_eligible": false
        }
      }
    },
    "sra": {
      "name": "NCBI Sequence Read Archive",
      "retrieval": {
        "javascript_load_required": true,
        "access_mode": "Complex download",
        "informative_html_metadata_tags": [
          "form"
        ]
      },
      "accessions": {
        "study": {
          "id_pattern": "SRP\\d+",
          "level": "dataset",
          "scan_eligible": true,
          "url_template": "https://www.ncbi.nlm.nih.gov/sra/__ID__"
        },
        "run": {
          "id_pattern": "SRR\\d+",
          "level": "record",
          "scan_eligible": true
        },
        "experiment": {
          "id_pattern": "SRX\\d+",
          "level": "record",
          "scan_eligible": true
        },
        "sample": {
          "id_pattern": "SRS\\d+",
          "level": "record",
          "scan_eligible": false
        }
      }
    },
    "bioproject": {
      "name": "NCBI BioProject",
      "accessions": {
        "project": {
          "id_pattern": "PRJNA\\d+",
          "level": "project",
          "scan_eligible": true,
          "url_template": "https://www.ncbi.nlm.nih.gov/bioproject/__ID__"
        },
        "project_ena_ddbj": {
          "id_pattern": "PRJ[DE]B\\d+",
          "level": "project",
          "scan_eligible": true
        }
      }
    },
    "biosamples": {
      "name": "NCBI BioSamples",
      "accessions": {
        "sample": {
          "id_pattern": "SAMN\\d+",
          "level": "record",
          "scan_eligible": true,
          "url_template": "https://www.ncbi.nlm.nih.gov/biosample/__ID__"
        },
        "sample_ena_ddbj": {
          "id_pattern": "SAM[ED][A-Z]?\\d+",
          "level": "record",
          "scan_eligible": true
        }
      }
    },
    "ena": {
      "name": "European Nucleotide Archive",
      "domains": [
        "www.ebi.ac.uk"
      ],
      "accessions": {
        "project": {
          "id_pattern": "PRJEB\\d+",
          "level": "project",
          "scan_eligible": true,
          "url_template": "https://www.ebi.ac.uk/ena/browser/view/__ID__"
        },
        "study": {
          "id_pattern": "ERP\\d+",
          "level": "dataset",
          "scan_eligible": false
        },
        "run": {
          "id_pattern": "ERR\\d+",
          "level": "record",
          "scan_eligible": false
        },
        "experiment": {
          "id_pattern": "ERX\\d+",
          "level": "record",
          "scan_eligible": false
        },
        "sample": {
          "id_pattern": "ERS\\d+",
          "level": "record",
          "scan_eligible": false
        },
        "biosample": {
          "id_pattern": "SAMEA\\d+",
          "level": "record",
          "scan_eligible": false
        },
        "study_insdc": {
          "id_pattern": "(E|D|S)RP\\d{6,}",
          "level": "dataset",
          "scan_eligible": false
        },
        "run_insdc": {
          "id_pattern": "(E|D|S)RR\\d{6,}",
          "level": "record",
          "scan_eligible": false
        },
        "experiment_insdc": {
          "id_pattern": "(E|D|S)RX\\d{6,}",
          "level": "record",
          "scan_eligible": false
        },
        "analysis": {
          "id_pattern": "(E|D|S)RZ\\d{6,}",
          "level": "record",
          "scan_eligible": false
        },
        "submission": {
          "id_pattern": "(E|D|S)RA\\d{6,}",
          "level": "record",
          "scan_eligible": false
        }
      }
    },
    "dbgap": {
      "name": "Database of Genotypes and Phenotypes",
      "retrieval": {
        "access_mode": "Application to access"
      },
      "accessions": {
        "study": {
          "id_pattern": "phs\\d{6}",
          "level": "dataset",
          "scan_eligible": true,
          "url_template": "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=__ID__",
          "default_id_suffix": ".v1.p1"
        }
      }
    },
    "ega": {
      "name": "European Genome-phenome Archive",
      "domains": [
        "ega-archive.org"
      ],
