{
  "repos": {
    "geo": {
      "repo_name": "Gene Expression Omnibus",
      "id_pattern": "GSE\\d+|GSM\\d+|GPL\\d+|GDS\\d+",
      "dataset_webpage_url_ptr": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=__ID__",
      "access_mode": "Complex download"
    },
    "proteomecentral.proteomexchange.org": {
      "repo_name": "ProteomeCentral",
      "id_pattern": "\\bPXD\\d{5,10}",
      "dataset_webpage_url_ptr": "https://proteomecentral.proteomexchange.org/cgi/GetDataset?ID=__ID__",
      "read_timeout": 3,
      "download_root": "",
      "access_mode": "Complex download"
    },
    "synapse.org": {
      "repo_name": "Synapse",
      "repo_root": "www.synapse.org",
      "id_pattern": "syn\\d{7,12}",
      "dataset_webpage_url_ptr": "https://www.synapse.org/[#!]*Synapse:__ID__",
      "access_mode": "Complex download or application to access"
    }
  }
}
